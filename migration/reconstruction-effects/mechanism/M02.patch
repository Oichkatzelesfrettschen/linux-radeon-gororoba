+static int radeon_rs480_cs_parser_init_fail(struct radeon_cs_parser *p,
+					   const char *reason, int ret,
+					   unsigned chunk, unsigned nchunks,
+					   u32 chunk_id, u32 length_dw)
+{
+	if (p->rdev &&
+	    (p->rdev->family == CHIP_RS400 ||
+	     p->rdev->family == CHIP_RS480)) {
+		DRM_ERROR("RS4xx CS parser init failed: reason=%s ret=%d "
+			  "chunk=%u/%u chunk_id=%u length_dw=%u "
+			  "cs_flags=0x%08x\n",
+			  reason, ret, chunk, nchunks, chunk_id, length_dw,
+			  p->cs_flags);
+	}
+
+	return ret;
+}
