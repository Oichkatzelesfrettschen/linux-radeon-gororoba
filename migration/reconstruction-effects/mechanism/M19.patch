diff --git a/radeon_cursor.c b/radeon_cursor.c
index 3507805..268da8d 100644
--- a/radeon_cursor.c
+++ b/radeon_cursor.c
@@ -264,8 +264,12 @@ static int radeon_cursor_move_locked(struct drm_crtc *crtc, int x, int y)
 int radeon_crtc_cursor_move(struct drm_crtc *crtc,
